<div class="card-grid">
<% for (const item of items) { %>
  <div class="lesson-card">
    <h3><a href="<%- item.path %>"><%= item.title %></a></h3>
    <% if (item.description) { %>
    <p><%= item.description %></p>
    <% } %>
    <% if (item.stand === 'geruest') { %>
    <p><span class="badge-soon">Gerüst</span></p>
    <% } else if (item.stand === 'entwurf') { %>
    <p><span class="badge-active">Entwurf</span></p>
    <% } %>
  </div>
<% } %>
</div>
